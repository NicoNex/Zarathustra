#!/bin/sh
# Writes what explains a refused login to the userstore, readable over USB.
DATA=${ZARATHUSTRA_DATA_DIR:-/var/local/zarathustra/data/ssh}
OUT=/mnt/us/zarathustra/ssh-diagnostica.txt
{
	date
	echo "== id"; id
	echo "== folders"; ls -ld / /var /var/local /var/local/zarathustra /var/local/zarathustra/data "$DATA"
	echo "== data"; ls -la "$DATA"
	echo "== keys"; cat "$DATA/authorized_keys"
	echo "== root"; grep '^root:' /etc/passwd
	echo "== /etc/shells"; cat /etc/shells 2>&1
	echo "== processes"; ps 2>/dev/null | grep -i '[d]ropbear'
	echo "== firewall"; iptables -L INPUT -n 2>&1 | head -20
	echo "== log"; tail -n 30 "$DATA/service.log"
} >"$OUT" 2>&1
echo "Salvata in zarathustra/ssh-diagnostica.txt"
